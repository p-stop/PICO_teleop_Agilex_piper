include README.md AGENTS.md uv.lock CHANGELOG.md
recursive-include src *.py *.json *.html
recursive-include src/robot_infra/web *.js *.css *.txt
recursive-include configs *.json
recursive-include tests *.py
recursive-include tests *.mjs
recursive-include tools *.py
recursive-include tools *.sh
recursive-include docs *.md
recursive-include docs/assets *.svg
recursive-include plans *.md
prune relevant-repo
prune artifacts
prune tmp
prune output
prune profiles/local
global-exclude *.py[cod] *.mcap *.bag *.db3 *.pem
