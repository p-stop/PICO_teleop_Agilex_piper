{
  "schema_version": "data-quality-metrics-proposal/0.1",
  "date": "2026-10-22",
  "documentation_only": true,
  "runtime_loader_supported": false,
  "scope": "指标定义与研究依据；不是实测结果、可运行配置或新增验收阈值。",
  "metric_definition_evidence": "P: project proposal; linked sources motivate the problem, not necessarily this exact formula.",
  "dimensions": [
    "integrity",
    "timing",
    "semantics",
    "perception",
    "behavior",
    "coverage",
    "deployment"
  ],
  "decision_statuses": [
    "pass",
    "fail",
    "unknown",
    "not_applicable"
  ],
  "evaluation_modes": [
    "gate",
    "monitor_only"
  ],
  "unknown_policy": "No measurement => null. No calibrated threshold => unknown/threshold_not_calibrated, even if a value exists. Required unknown => pending. Required metric cannot be not_applicable.",
  "threshold_basis_types": [
    "contract",
    "task_error_budget",
    "empirical_validation",
    "literature_reference_only"
  ],
  "availability_note": "implemented_partial refers to existing checks or supporting records, not this proposed report interface. proposed may be computable from existing logs. No new metric implementation in plan017.",
  "metrics": [
    {
      "id": "I01",
      "definition_version": 1,
      "dimension": "integrity",
      "name": "文件与引用完整性",
      "unit": "count",
      "level": "对象/episode",
      "denominator": "manifest与索引列出的全部必需对象；未索引对象另查",
      "definition": "必需对象损坏/缺失计数",
      "current_availability": "implemented_partial",
      "default_mode": "gate",
      "threshold": {
        "basis": "contract",
        "rule": "必需对象损坏/缺失数为0"
      },
      "source_ids": [
        "qwen",
        "droid"
      ],
      "formula_evidence": "project_proposal"
    },
    {
      "id": "I02",
      "definition_version": 1,
      "dimension": "integrity",
      "name": "必需流与有效覆盖",
      "unit": "ratio,count",
      "level": "stream/episode",
      "denominator": "episode物理时长；必需流集合",
