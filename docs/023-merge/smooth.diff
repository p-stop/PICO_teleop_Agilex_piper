+TELEOP_FILTER_KEYS = ('position_min_cutoff_hz', 'position_beta', 'orientation_min_cutoff_hz',
+                      'orientation_beta', 'position_deadband_m', 'rotation_deadband_rad',
+                      'command_alpha', 'max_joint_rate_rad_s', 'rate_headroom',
+                      'accept_max_position_error_m')
+
+
+def _q_mul(a, b):
+    ax, ay, az, aw = a; bx, by, bz, bw = b
+    return (aw*bx+ax*bw+ay*bz-az*by,
+            aw*by-ax*bz+ay*bw+az*bx,
+            aw*bz+ax*by-ay*bx+az*bw,
+            aw*bw-ax*bx-ay*by-az*bz)
+
+
+def _q_conj(q):
+    return (-q[0], -q[1], -q[2], q[3])
+
+
+def _q_normalize(q):
+    norm = math.sqrt(sum(v*v for v in q))
+    if not math.isfinite(norm) or norm < 1e-12: raise ValueError('invalid tracked quaternion')
+    return tuple(v/norm for v in q)
+
+
+def _q_relative_angle(a, b):
+    r = _q_mul(a, _q_conj(b))
+    return 2*math.atan2(math.sqrt(max(0., min(1., 1-r[3]*r[3]))), abs(r[3]))
+
+
+def _q_slerp(a, b, t):
+    dot = sum(x*y for x, y in zip(a, b))
+    if dot < 0.: b = tuple(-v for v in b); dot = -dot
+    if dot > .9995:
+        return _q_normalize(tuple(x+t*(y-x) for x, y in zip(a, b)))
+    theta = math.acos(min(1., dot)); sin = math.sin(theta)
+    return tuple(math.sin((1.-t)*theta)/sin*x+math.sin(t*theta)/sin*y for x, y in zip(a, b))
+
+
+class _OneEuro:
+    """Adaptive cutoff shared by the position and orientation filters."""
+    def __init__(self, min_cutoff_hz, beta):
+        self.min_cutoff_hz, self.beta, self.d_cutoff_hz = min_cutoff_hz, beta, 1.
+        self.derivative = 0.
+
+    @staticmethod
+    def alpha(cutoff, dt):
+        tau = 1/(2*math.pi*cutoff)
+        return 1/(1+tau/dt)
+
+    def factor(self, speed, dt):
+        a = self.alpha(self.d_cutoff_hz, dt)
+        self.derivative = a*speed+(1-a)*self.derivative
+        return self.alpha(self.min_cutoff_hz+self.beta*abs(self.derivative), dt)
+
+
+class _VectorFilter(_OneEuro):
+    """Position low-pass: strong smoothing at rest, low lag during motion."""
+    def __init__(self, min_cutoff_hz, beta):
+        super().__init__(min_cutoff_hz, beta)
+        self.value = self.filtered = None
+
+    def step(self, value, dt):
+        if self.filtered is None:
+            self.value, self.filtered = list(value), list(value)
+            return list(value)
+        speed = math.sqrt(sum((v-p)**2 for v, p in zip(value, self.value)))/dt
+        a = self.factor(speed, dt)
+        self.filtered = [a*v+(1-a)*f for v, f in zip(value, self.filtered)]
+        self.value = list(value)
+        return list(self.filtered)
+
+
+class _QuaternionFilter(_OneEuro):
+    """Orientation SLERP low-pass with speed-adaptive cutoff; stays normalized."""
+    def __init__(self, min_cutoff_hz, beta):
+        super().__init__(min_cutoff_hz, beta)
+        self.filtered = None
+
+    def step(self, q, dt):
+        q = _q_normalize(q)
+        if self.filtered is None:
+            self.filtered = q; return q
+        a = self.factor(_q_relative_angle(q, self.filtered)/dt, dt)
+        self.filtered = _q_normalize(_q_slerp(self.filtered, q, a))
+        return self.filtered
+
+
+class GripFilter:
+    """Per-engagement input shaping: filtered hand pose with anchor-relative deadbands."""
+    def __init__(self, grip, settings):
+        self.settings = settings
+        self.position = _VectorFilter(settings['position_min_cutoff_hz'], settings['position_beta'])
+        self.orientation = _QuaternionFilter(settings['orientation_min_cutoff_hz'], settings['orientation_beta'])
+        self.last_s = None
+        self.anchor = (self.position.step(list(grip['position_m']), .02),
+                       self.orientation.step(tuple(grip['orientation_xyzw']), .02))
+
+    def step(self, grip, now):
+        dt = .02 if self.last_s is None else min(.2, max(1e-3, now-self.last_s))
+        self.last_s = now
+        position = self.position.step(list(grip['position_m']), dt)
+        orientation = self.orientation.step(tuple(grip['orientation_xyzw']), dt)
+        anchor_p, anchor_q = self.anchor
+        deadband = self.settings['position_deadband_m']
+        delta = [p-c for p, c in zip(position, anchor_p)]
+        magnitude = math.sqrt(sum(v*v for v in delta))
+        factor = 0. if magnitude <= deadband else (magnitude-deadband)/magnitude
+        effective_p = [c+factor*d for c, d in zip(anchor_p, delta)]
+        relative = _q_mul(orientation, _q_conj(anchor_q))
+        limit = self.settings['rotation_deadband_rad']
+        if limit > 0:
+            angle = _q_relative_angle(relative, (0., 0., 0., 1.))
+            if angle <= limit: relative = (0., 0., 0., 1.)
+            else: relative = _q_normalize(_q_slerp((0., 0., 0., 1.), relative, (angle-limit)/angle))
+        return {'position_m': effective_p, 'orientation_xyzw': _q_mul(relative, anchor_q)}
+
 
