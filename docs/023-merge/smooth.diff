+    def _shape_command(self,side,measured,target):
+        # Output shaping: first-order blending toward the latest gated target,
+        # then a per-cycle joint rate limit (the v1 ramp semantics).
+        now=self.clock()
+        last=self.sent.get(side)
+        current=measured if last is None else last[0]
+        alpha=self.teleop_filter['command_alpha']
+        blended=tuple(c+alpha*(t-c) for c,t in zip(current,target))
+        dt=1/self.config['session']['control_hz'] if last is None else max(0.,now-last[1])
+        allowed=self.teleop_filter['max_joint_rate_rad_s']*min(.08,dt)*self.teleop_filter['rate_headroom']
+        diff=max((abs(t-c) for t,c in zip(target,blended)),default=0.)
+        ratio=1. if diff<=1e-12 else min(1.,allowed/diff)
+        shaped=tuple(c+ratio*(t-c) for c,t in zip(current,blended))
+        self.sent[side]=(shaped,now)
+        return shaped
+
